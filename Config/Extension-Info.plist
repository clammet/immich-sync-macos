<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>OpenCloud File Provider</string>
	<key>CFBundleDisplayName</key>
	<string>OpenCloud</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleSymbolName</key>
	<string>cloud</string>
	<key>OpenCloudAppGroup</key>
	<string>$(OPENCLOUD_APP_GROUP)</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>OpenCloud Sync connects to OpenCloud for files and optionally Immich for media actions on the local network.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.fileprovider-nonui</string>
		<key>NSExtensionPrincipalClass</key>
		<string>OpenCloudFileProviderExtension</string>
		<key>NSExtensionFileProviderDocumentGroup</key>
		<string>$(OPENCLOUD_APP_GROUP)</string>
		<key>NSExtensionFileProviderSupportsEnumeration</key>
		<true/>
		<key>NSExtensionFileProviderAllowsUserControlledEviction</key>
		<true/>
		<key>NSExtensionFileProviderDownloadPipelineDepth</key>
		<integer>4</integer>
		<key>NSExtensionFileProviderUploadPipelineDepth</key>
		<integer>2</integer>
		<key>NSExtensionFileProviderMetadataOnlyUploadPipelineDepth</key>
		<integer>2</integer>
		<key>NSExtensionFileProviderActions</key>
		<array>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>app.opencloud.sync.keep</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>Always keep available</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>fileproviderItems.@count &gt; 0</string>
			</dict>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>app.opencloud.sync.automatic</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>Make available on demand</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>fileproviderItems.@count &gt; 0</string>
			</dict>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>app.opencloud.sync.inherit</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>Use parent folder availability</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>fileproviderItems.@count &gt; 0</string>
			</dict>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>app.opencloud.sync.link</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>Create OpenCloud link (result in app)</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>fileproviderItems.@count &gt; 0</string>
			</dict>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>app.opencloud.sync.sharing</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>Manage OpenCloud sharing (open in app)</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>fileproviderItems.@count &gt; 0</string>
			</dict>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>app.opencloud.sync.immichAlbum</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>Create Immich album (result in app)</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>fileproviderItems.@count &gt; 0</string>
			</dict>
			<dict>
				<key>NSExtensionFileProviderActionIdentifier</key>
				<string>app.opencloud.sync.immichLink</string>
				<key>NSExtensionFileProviderActionName</key>
				<string>Create Immich sharing link (result in app)</string>
				<key>NSExtensionFileProviderActionActivationRule</key>
				<string>fileproviderItems.@count &gt; 0</string>
			</dict>
		</array>
	</dict>
</dict>
</plist>
